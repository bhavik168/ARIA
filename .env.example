# AWS — copy this file to .env and fill in your values
AWS_REGION=us-west-2
AWS_ACCOUNT_ID=YOUR_ACCOUNT_ID_HERE
AWS_PROFILE=YOUR_PROFILE_NAME

# Bedrock model IDs — cross-region inference profiles (the "us." prefix), matching
# the defaults used in the Lambda handlers. Enable access for all of these.
VERIFIER_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
SYNTHESIS_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
MEDICAL_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
HAZMAT_MODEL_ID=us.anthropic.claude-3-5-haiku-20241022-v1:0
REPORT_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# DynamoDB table names
INCIDENTS_TABLE=aria-incidents
UNITS_TABLE=aria-units
HOSPITALS_TABLE=aria-hospitals
OVERRIDES_TABLE=aria-overrides

# S3 — single bucket (name = aria-{your-account-id})
ARIA_BUCKET=aria-YOUR_ACCOUNT_ID

# API Gateway
API_BASE_URL=https://YOUR_REST_API_ID.execute-api.us-west-2.amazonaws.com/prod
WS_URL=wss://YOUR_WS_API_ID.execute-api.us-west-2.amazonaws.com/prod

# Google Maps
GOOGLE_MAPS_API_KEY=REPLACE_ME

# Bedrock Knowledge Base + Data Source IDs (fill in after KB is created)
BEDROCK_KB_ID=REPLACE_ME
BEDROCK_DS_ID=REPLACE_ME

# Bedrock Guardrail ID (fill in after Phase 7)
BEDROCK_GUARDRAIL_ID=REPLACE_ME
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Lambda function names
STREAM_PROCESSOR_FUNCTION=aria-stream-processor
COORDINATOR_FUNCTION=aria-coordinator
NAVIGATION_FUNCTION=aria-navigation-tool
MEDICAL_FUNCTION=aria-medical-tool
HAZMAT_FUNCTION=aria-hazmat-tool
VERIFIER_FUNCTION=aria-verifier
MOCK_HOSPITAL_FUNCTION=aria-mock-hospital
REPORT_FUNCTION=aria-report
