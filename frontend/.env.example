# ARIA Dispatcher Dashboard — Environment Variables
# Copy this file to .env and fill in your values.

# REST API base URL (no trailing slash)
# Example: https://abc123.execute-api.us-east-1.amazonaws.com/prod
VITE_API_BASE_URL=

# WebSocket URL (no trailing slash)
# Example: wss://abc123.execute-api.us-east-1.amazonaws.com/prod
VITE_WS_URL=

# Mapbox GL JS access token (for live map in production)
# Example: pk.eyJ1IjoiYXJpYSIsImEiOiI...
VITE_MAPBOX_TOKEN=
